  "text": "{{ (() => { const d = (fetch_customer_detail.data && fetch_customer_detail.data[0]) || {}; const esc = (v) => (v==null||v==='')?'—':(typeof v==='object'?JSON.stringify(v):String(v)); const row = (label,val)=>`<tr><td style='padding:10px 14px;color:#334155;width:280px;border-bottom:1px solid #dfe4ea;'>${label}</td><td style='padding:10px 14px;color:#0f172a;font-weight:600;border-bottom:1px solid #dfe4ea;'>${esc(val)}</td></tr>`; const section = (title,rowsHtml)=>`<div style='margin-bottom:22px;'><div style='font-size:15px;font-weight:700;color:#1e3a5f;margin-bottom:8px;'>${title}</div><table style='width:100%;border-collapse:collapse;background:#eef1f5;border-radius:6px;overflow:hidden;'>${rowsHtml}</table></div>`; const main = section('Main Information', row('Customer ID', d.id)+row('Customer Name', d.name)); const all = section('All available fields (from customers_search)', Object.keys(d).length? Object.keys(d).map(k=>row(k,d[k])).join('') : row('No data returned','')); return `<div style='font-family:sans-serif;padding:6px 4px;'>${main}${all}</div>`; })() }}",
