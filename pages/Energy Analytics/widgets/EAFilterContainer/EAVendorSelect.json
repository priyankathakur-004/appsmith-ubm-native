{
  "accentColor": "{{appsmith.theme.colors.primaryColor}}",
  "animateLoading": true,
  "borderRadius": "{{appsmith.theme.borderRadius.appBorderRadius}}",
  "boxShadow": "none",
  "isFilterable": true,
  "isLoading": false,
  "isVisible": "{{ EAViewSelect.selectedOptionValue === \"Bill Health\" }}",
  "labelText": "Vendor",
  "labelPosition": "Top",
  "labelTextColor": "#94a3b8",
  "labelTextSize": "0.875rem",
  "labelStyle": "",
  "key": "eaFVend00001",
  "widgetId": "eaFVend00001",
  "widgetName": "EAVendorSelect",
  "leftColumn": 11,
  "rightColumn": 22,
  "topRow": 9,
  "bottomRow": 17,
  "mobileLeftColumn": 11,
  "mobileRightColumn": 22,
  "mobileTopRow": 9,
  "mobileBottomRow": 17,
  "parentColumnSpace": 15,
  "parentRowSpace": 10,
  "parentId": "eaFiltCanv01",
  "renderMode": "CANVAS",
  "version": 1,
  "type": "MULTI_SELECT_WIDGET_V2",
  "optionLabel": "label",
  "optionValue": "value",
  "dynamicBindingPathList": [
    {
      "key": "borderRadius"
    },
    {
      "key": "accentColor"
    },
    {
      "key": "sourceData"
    },
    {
      "key": "defaultOptionValue"
    },
    {
      "key": "isVisible"
    }
  ],
  "dynamicTriggerPathList": [
    {
      "key": "onOptionChange"
    }
  ],
  "sourceData": "{{ (fetch_analytics_data.data || []).map(r => r.vendor_name).filter(Boolean).filter((v,i,a) => a.indexOf(v) === i).sort().map(v => ({label: v, value: v})) }}",
  "dynamicPropertyPathList": [
    {
      "key": "sourceData"
    }
  ],
  "defaultOptionValue": "{{ [] }}",
  "onOptionChange": "{{ EA_Init.applyFilters() }}"
}
